library(tidyverse)
user_collab_filter <- function(data, target_user, similarity_metric, k) {
# Check if target user exists
if (!(target_user %in% rownames(data))) {
message(paste("Error:", target_user, "not found in the dataset."))
return(NULL)
}
target_row <- data[target_user, ]
missing_items <- names(target_row)[is.na(target_row)]
# Check for missing ratings
if (length(missing_items) == 0) {
message(paste(target_user, "has no missing ratings."))
return(NULL)
}
# Center by user means and impute with 0
user_means <- rowMeans(data, na.rm = TRUE)
centered <- data - user_means
centered[is.na(centered)] <- 0
target_vec <- as.numeric(centered[target_user, ])
# Compute similarities
sims <- c()
for (user in rownames(data)) {
if (user == target_user) next
other_vec <- as.numeric(centered[user, ])
if (similarity_metric == "Cosine") {
norm_prod <- sqrt(sum(target_vec^2)) * sqrt(sum(other_vec^2))
sim <- if (norm_prod > 0) sum(target_vec * other_vec) / norm_prod else 0
} else if (similarity_metric == "L2") {
sim <- -sqrt(sum((target_vec - other_vec)^2))
}
sims[user] <- sim
}
# Min-Max scale
min_s <- min(sims)
max_s <- max(sims)
if (max_s > min_s) {
sims <- (sims - min_s) / (max_s - min_s)
}
# Predict missing ratings
predictions <- as.numeric(target_row)
names(predictions) <- names(target_row)
for (item in missing_items) {
# Get users who rated this item
rated_users <- names(sims)[!is.na(data[names(sims), item])]
rated_sims <- sims[rated_users]
# Top k
top_k <- sort(rated_sims, decreasing = TRUE)[1:min(k, length(rated_sims))]
top_users <- names(top_k)
if (length(top_k) > 0 && sum(top_k) > 0) {
ratings <- as.numeric(data[top_users, item])
predictions[item] <- weighted.mean(ratings, top_k)
} else {
predictions[item] <- mean(data[[item]], na.rm = TRUE)
}
}
return(predictions)
}
# Load data
rmp_df <- read.csv("fake_rmp.csv", row.names = 1)
# Part 2b tests
result <- user_collab_filter(rmp_df, "Student_5", "Cosine", 3)
cat("Student_5 - Dr. Johnson:", round(result["Dr..Johnson"], 2), "\n")
user_collab_filter(rmp_df, "Student_3", "Cosine", 3)
# Part 2c
cat("\nPredictions for Dr. Gerber (k=5):\n")
for (student in c("Student_1", "Student_2", "Student_13")) {
l2 <- user_collab_filter(rmp_df, student, "L2", 5)["Dr..Gerber"]
cos <- user_collab_filter(rmp_df, student, "Cosine", 5)["Dr..Gerber"]
cat(student, ": L2=", round(l2, 2), ", Cosine=", round(cos, 2), "\n", sep = "")
}

knitr::opts_chunk$set(echo = TRUE)
# (a) Gibbs Sampling
y_obs <- c(-2, 1)
rho   <- -0.6
# conditional posteriors from the hw:
# mu1 | mu2, y ~ N(y1 + rho*(mu2 - y2), sqrt(1 - rho^2))
# mu2 | mu1, y ~ N(y2 + rho*(mu1 - y1), sqrt(1 - rho^2))
cond_sd <- sqrt(1 - rho^2)
gibbs_posterior <- function(n, burn = 0.18) {
total_samples <- floor(n / (1 - burn))
m <- floor(total_samples * burn)
samples <- matrix(0, nrow = total_samples, ncol = 2)
mu1 <- 0  # initialize
mu2 <- 0
for (i in 1:total_samples) {
mu1 <- rnorm(1, mean = y_obs[1] + rho * (mu2 - y_obs[2]), sd = cond_sd)
mu2 <- rnorm(1, mean = y_obs[2] + rho * (mu1 - y_obs[1]), sd = cond_sd)
samples[i, ] <- c(mu1, mu2)
}
samples[(m + 1):total_samples, ]  # discard burn-in
}
set.seed(42)
draws_gibbs <- gibbs_posterior(n = 10000)
# Trace plots
par(mfrow = c(2, 1))
plot(draws_gibbs[, 1], type = "l", col = "blue", main = "Trace Plot: mu1", ylab = "mu1")
plot(draws_gibbs[, 2], type = "l", col = "red",    main = "Trace Plot: mu2", ylab = "mu2")
# ACF plots
par(mfrow = c(2, 1))
acf(draws_gibbs[, 1], main = "ACF: mu1")
acf(draws_gibbs[, 2], main = "ACF: mu2")
par(mfrow = c(1, 1))
# (b) Compare to true parameters
# true joint posterior: [mu1, mu2] | y ~ MVN(y, Sigma) where Sigma = [[1, rho],[rho, 1]]
true_mean   <- y_obs  # c(-2, 1)
true_cov    <- matrix(c(1, rho, rho, 1), nrow = 2)
cat("Sample mean:    ", colMeans(draws_gibbs), "\n")
cat("True mean:      ", true_mean, "\n\n")
cat("Sample covariance:\n"); print(cov(draws_gibbs))
cat("True covariance:\n");   print(true_cov)
# (a) Gibbs Sampling
y_obs <- c(-2, 1)
rho   <- -0.6
# conditional posteriors from the hw:
# mu1 | mu2, y ~ N(y1 + rho*(mu2 - y2), sqrt(1 - rho^2))
# mu2 | mu1, y ~ N(y2 + rho*(mu1 - y1), sqrt(1 - rho^2))
cond_sd <- sqrt(1 - rho^2)
gibbs_posterior <- function(n, burn = 0.18) {
total_samples <- floor(n / (1 - burn))
m <- floor(total_samples * burn)
samples <- matrix(0, nrow = total_samples, ncol = 2)
mu1 <- 0  # initialize
mu2 <- 0
for (i in 1:total_samples) {
mu1 <- rnorm(1, mean = y_obs[1] + rho * (mu2 - y_obs[2]), sd = cond_sd)
mu2 <- rnorm(1, mean = y_obs[2] + rho * (mu1 - y_obs[1]), sd = cond_sd)
samples[i, ] <- c(mu1, mu2)
}
samples[(m + 1):total_samples, ]  # discard burn-in
}

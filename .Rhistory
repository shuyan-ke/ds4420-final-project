library(ggplot2)
# Data
df <- read.csv("ds4420_spotify.csv")
# Data
df <- read.csv("ds4420_spotify.csv")
n <- nrow(df)
y_sum <- sum(df$explicit)   # 36
# Hyperparameters
alpha_prior <- 2
beta_prior  <- 18
alpha_post  <- alpha_prior + y_sum
beta_post   <- beta_prior  + (n - y_sum)
# Key values
prior_mean <- alpha_prior / (alpha_prior + beta_prior)
mle        <- y_sum / n
post_mean  <- alpha_post  / (alpha_post + beta_post)
# Grid of theta values
theta_vals <- seq(0, 0.5, length.out = 1000)
prior_dens <- dbeta(theta_vals, alpha_prior, beta_prior)
post_dens  <- dbeta(theta_vals, alpha_post,  beta_post)
# Plot
plot(theta_vals, post_dens,
type = "l", col = "black", lwd = 2,
ylim = c(0, max(prior_dens, post_dens) * 1.05),
xlab = expression(theta), ylab = "Density",
main = "Prior vs Posterior for P(Explicit)")
lines(theta_vals, prior_dens, col = "gray50", lwd = 2, lty = 2)
abline(v = prior_mean, col = "red",    lwd = 2, lty = 2)
abline(v = mle,        col = "blue",   lwd = 2, lty = 2)
abline(v = post_mean,  col = "purple", lwd = 2, lty = 2)
legend("topright",
legend = c(
paste0("Posterior Beta(", alpha_post, ",", beta_post, ")"),
paste0("Prior Beta(", alpha_prior, ",", beta_prior, ")"),
paste0("Prior Mean = ", round(prior_mean, 3)),
paste0("MLE = ",        round(mle,        3)),
paste0("Posterior Mean = ", round(post_mean, 3))
),
col    = c("black", "gray50", "red", "blue", "purple"),
lwd    = 2,
lty    = c(1, 2, 2, 2, 2))
df <- read.csv("ds4420_spotify.csv")
n     <- nrow(df)
y_bar <- mean(df$track_pop)
# Parameters
sigma <- 20; eta <- 50; tau <- 2
# Posterior parameters
mu_star    <- (n*y_bar/sigma^2 + eta/tau^2) / (n/sigma^2 + 1/tau^2)
sigma_star <- sqrt(1 / (n/sigma^2 + 1/tau^2))
# Key values
prior_mean <- eta
mle        <- y_bar
# Plot
x_vals <- seq(40, 80, length.out = 1000)
prior_dens <- dnorm(x_vals, eta, tau)
post_dens  <- dnorm(x_vals, mu_star, sigma_star)
plot(x_vals, post_dens, type="l", lwd=2, col="black",
ylim=c(0, max(post_dens, prior_dens) * 1.1),
xlim=c(40, 80),
xlab=expression(mu), ylab="Density",
main="Prior vs Posterior for Mean Popularity (a)")
lines(x_vals, prior_dens, lwd=2, col="gray", lty=2)
abline(v=prior_mean, col="red",    lty=2, lwd=1.5)
abline(v=mle,        col="blue",   lty=2, lwd=1.5)
abline(v=mu_star,    col="purple", lty=2, lwd=1.5)
legend("topright",
legend=c(paste0("Posterior N(", round(mu_star,2), ",", round(sigma_star,2), ")"),
"Prior N(50,2)",
paste0("Prior Mean = ", prior_mean),
paste0("MLE = ", round(mle, 3)),
paste0("Posterior Mean = ", round(mu_star, 3))),
col=c("black","gray","red","blue","purple"),
lty=c(1,2,2,2,2), lwd=2)

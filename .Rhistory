library(mvtnorm)
p <- function(y, mu, Sigma) {
dmvnorm(y, mean = mu, sigma = Sigma)
}
gaussian_metropolis <- function(n, mu, Sigma, sigma = 2, burn = 0.18) {
total_samples <- floor(n / (1 - burn))
m <- as.integer(total_samples * burn)  # burn-in amount
samples <- list()
current <- mu  # initialize at the mean
accepted <- 0
while (length(samples) < total_samples) {
proposal <- rnorm(length(mu), mean = current, sd = sigma)  # isotropic Gaussian proposal
alpha <- p(proposal, mu, Sigma) / p(current, mu, Sigma)    # Metropolis ratio
if (runif(1) < alpha) {
current <- proposal
accepted <- accepted + 1
}
samples[[length(samples) + 1]] <- current  # always record (accepted or old)
}
acceptance_rate <- accepted / total_samples
cat(sprintf("Acceptance rate: %.3f\n", acceptance_rate))
samples <- do.call(rbind, samples)
samples[(m + 1):nrow(samples), ]  # discard burn-in
}

# Define the objective function f(x) = 2x^4 - 3x^3 + 1
f <- function(x) {
return(2 * x^4 - 3 * x^3 + 1)
}
# Define the derivative function f'(x) = 8x^3 - 9x^2 = x^2(8x - 9)
df <- function(x) {
return(x^2(8 * x - 9))
}
# Initialize parameters for gradient descent
x <- 0.5
eta <- 0.05
epochs <- 2
# Vector to store the function values at each iteration
f_value_list <- numeric(epochs)
# Gradient descent loop
for (i in 1:epochs) {
gradient <- df_dx(x)
x <- x - eta * gradient # applies gradient descent rule: xi+1 = xi - (df/dx)(xi)
f_value_list[i] <- f(x)
}

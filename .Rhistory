total <- ceiling(n / (1 - burn))  # total iterations including burn-in
samples <- matrix(NA, nrow = total, ncol = length(mu))
samples[1, ] <- mu  # initialize at mean
accepted <- 0
for (i in 2:total) {
current <- samples[i - 1, ]
proposal <- current + rnorm(length(mu), mean = 0, sd = sigma)
alpha <- min(1, p(proposal, mu, Sigma) / p(current, mu, Sigma))
if (runif(1) < alpha) {
samples[i, ] <- proposal
accepted <- accepted + 1
} else {
samples[i, ] <- current
}
}
accept_rate <- accepted / (total - 1)
cat("Acceptance rate:", round(accept_rate * 100, 2), "%\n")
# discard burn-in
burn_n <- ceiling(burn * total)
samples[(burn_n + 1):total, ]
}
set.seed(42) # this is just to make the results reproducible
mu <- 1
sigma <- 2
k <- 5
# logit-normal density
p_theta <- function(theta) {
(1 / (sqrt(2 * pi) * sigma)) *
exp(-(log(theta / (1 - theta)) - mu)^2 / (2 * sigma^2)) *
(1 / (theta * (1 - theta)))
}
# Verification plot: kq(v) >= p(v)
theta_grid <- seq(0.001, 0.999, length.out = 1000)
plot(theta_grid, p_theta(theta_grid), type = "l", col = "blue", lwd = 2,
ylim = c(0, k + 0.5),
xlab = expression(theta), ylab = "Density",
main = "Verification: kq(v) >= p(v)")
lines(theta_grid, rep(k, 1000), col = "red", lwd = 2, lty = 2)
legend("topright", legend = c("p(theta)", "kq(v) = 5"),
col = c("blue", "red"), lty = c(1, 2), lwd = 2)
# Rejection sampling
samples <- c()
total_proposed <- 0
while (length(samples) < 10000) {
v <- runif(1)                          # propose from Beta(1,1) = Unif(0,1)
u <- runif(1)                          # acceptance threshold
total_proposed <- total_proposed + 1
if (u < p_theta(v) / (k * 1)) {       # q(v) = 1 since Unif(0,1)
samples <- c(samples, v)
}
}
cat("Acceptance rate:", round(10000 / total_proposed * 100, 2), "%\n")
# ── Verification: histogram vs theoretical density
hist(samples, breaks = 60, freq = FALSE, col = "lightblue", border = "white",
xlab = expression(theta), main = "Rejection Samples vs Theoretical p(theta)")
lines(theta_grid, p_theta(theta_grid), col = "tomato", lwd = 2)
legend("topright", legend = c("Samples", "p(theta)"),
fill = c("lightblue", NA), border = c("black", NA),
col = c(NA, "tomato"), lty = c(NA, 1), lwd = c(NA, 2), merge = TRUE)
# Ancestral sampling: sample (theta, y) from joint p(y, theta)
y_samples <- rbinom(length(samples), size = 1, prob = samples)
# (1) Theoretical joint distribution on a grid
theta_grid <- seq(0.001, 0.999, length.out = 1000)
p_joint_y1 <- theta_grid * p_theta(theta_grid)       # p(y=1, theta) = theta * p(theta)
p_joint_y0 <- (1 - theta_grid) * p_theta(theta_grid) # p(y=0, theta) = (1-theta) * p(theta)
plot(theta_grid, p_joint_y1, type = "l", col = "blue", lwd = 2,
xlab = expression(theta), ylab = "p(y, theta)",
main = "Theoretical Joint Distribution p(y, theta)")
lines(theta_grid, p_joint_y0, col = "orange", lwd = 2)
legend("topright", legend = c("y = 1", "y = 0"),
col = c("blue", "orange"), lwd = 2)
# (2) Empirical joint distribution as 2D histogram
par(mfrow = c(1, 2))
hist(samples[y_samples == 1], breaks = 60, freq = FALSE,
col = adjustcolor("purple", alpha.f = 0.7), border = "white",
xlab = expression(theta), main = "Empirical Joint: y = 1",
xlim = c(0, 1))
hist(samples[y_samples == 0], breaks = 60, freq = FALSE,
col = adjustcolor("yellow", alpha.f = 0.7), border = "white",
xlab = expression(theta), main = "Empirical Joint: y = 0",
xlim = c(0, 1))
install.packages("ggplot2")
# Plot histogram and estimated normal density
ggplot(data = data.frame(samples), aes(x = samples)) +
geom_histogram(aes(y = after_stat(density)), bins = 30, fill = "blue", alpha = 0.5) +
stat_function(fun = dnorm, args = list(mean = mu_hat, sd = sigma_hat), col = "red") +
labs(title = "Histogram of Gaussian", x = "Value", y = "Density")

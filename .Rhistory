# (b) Sample and verify
set.seed(42)
mu_true    <- c(-4, 6)
Sigma_true <- matrix(c(1, -0.6, -0.6, 1), nrow = 2)
draws <- gaussian_metropolis(n = 10000, mu = mu_true, Sigma = Sigma_true, sigma = 0.7)
# Trace plots
par(mfrow = c(2, 1))
plot(draws[, 1], type = "l", col = "blue", main = "Trace Plot: y1", ylab = "y1")
plot(draws[, 2], type = "l", col = "red",    main = "Trace Plot: y2", ylab = "y2")
# ACF plots
par(mfrow = c(2, 1))
acf(draws[, 1], main = "ACF: y1")
acf(draws[, 2], main = "ACF: y2")
par(mfrow = c(1, 1))
# Compare to true parameters
cat("Sample mean:  ", colMeans(draws), "\n")
cat("True mean:    ", mu_true, "\n")
cat("Sample covariance:\n"); print(cov(draws))
cat("True covariance:\n");   print(Sigma_true)
